//OSELIST  JOB (OSE),'OSE-011 NAMES',CLASS=A,MSGCLASS=A,
//             MSGLEVEL=(1,1)
//*--------------------------------------------------------------------
//* OSE-011 NAME-COLLISION LISTING (READ-ONLY).  RUN BY
//* SCRIPTS/AUDIT-LISTING.SH UNDER A GUEST LEASE.  THE SUBMITTER SUPPLIES
//* USER= AND PASSWORD= AT SUBMIT TIME; NEVER STORED IN THE REPOSITORY.
//*
//* REVISED AFTER THE FIRST GUEST RUN (2026-11-27): MVS 3.8J HAS NO
//* IEFSSNXX PARMLIB MEMBER (S013-18); THE SUBSYSTEM NAMES TABLE IS LOAD
//* MODULE IEFJSSNT IN SYS1.LINKLIB (SYSGEN STAGE2 SG37), DUMPED BY
//* HMBLIST.  EVERY STEP HAS COND=EVEN, SO ONE FAILED STEP DOES NOT HIDE
//* THE OTHERS.
//*
//* REVISED AFTER REVIEW ROUND 1: THE LIBRARY LIST IS NOW DERIVED FROM
//* THE SYSGEN CONFIGURATION (RESEARCH 2026-11-26-TSO-TERMINAL-AUDIT
//* N-3), AND STEPS CFG* PRINT THE LIVE CONFIGURATION MEMBERS SO THAT A
//* LIBRARY ADDED LATER (BY AN MVP PACKAGE OR A USERMOD) IS SEEN TOO.
//* COMPARE EVERY DSN NAMED IN THE CFG* OUTPUT WITH THE LIST STEP; A
//* CONFIGURED LIBRARY MISSING FROM LIST: EXTEND THE JOB AND RE-RUN.
//*
//* CANDIDATE NAMES (RESEARCH N-1):
//*   COMMAND OMVS, OSH     HLQ OSE     STC OSE, OSED
//*   SUBSYSTEM OSE1, OSES  (MUST DIFFER FROM THE STC NAME)
//* SEARCH THE OUTPUT FOR EACH NAME AS A WHOLE MEMBER NAME OR ALIAS.
//* EXPECTED RC: CFG* 0-4 (HMBLIST AMB126I GIVES 4); LIST 0-12 (A
//* LIBRARY ABSENT ON THIS IMAGE GIVES A LISTDS ERROR, ITSELF EVIDENCE).
//*--------------------------------------------------------------------
//* CONFIGURATION MEMBERS THAT DEFINE THE SEARCH ORDERS
//CFGLNK   EXEC PGM=IEBGENER,COND=EVEN
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=SYS1.PARMLIB(LNKLST00),DISP=SHR
//SYSUT2   DD  SYSOUT=*
//CFGAPF   EXEC PGM=IEBGENER,COND=EVEN
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=SYS1.PARMLIB(IEAAPF00),DISP=SHR
//SYSUT2   DD  SYSOUT=*
//CFGSSN   EXEC PGM=HMBLIST,COND=EVEN
//SYSPRINT DD  SYSOUT=*
//LIB      DD  DSN=SYS1.LINKLIB,DISP=SHR
//SYSIN    DD  *
 LISTLOAD OUTPUT=MODULE,DDN=LIB,MEMBER=IEFJSSNT
/*
//CFGJES   EXEC PGM=IEBGENER,COND=EVEN
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=SYS1.PROCLIB(JES2),DISP=SHR
//SYSUT2   DD  SYSOUT=*
//CFGTSO   EXEC PGM=IEBGENER,COND=EVEN
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=SYS1.PROCLIB(IKJACCNT),DISP=SHR
//SYSUT2   DD  SYSOUT=*
//CFGLOG   EXEC PGM=IEBGENER,COND=EVEN
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=SYS1.CMDPROC(TSOLOGON),DISP=SHR
//SYSUT2   DD  SYSOUT=*
//* MEMBER LISTS OF EVERY CONFIGURED LIBRARY, GROUPED BY SEARCH ORDER
//* EXTENDED AFTER THE 2026-11-27 COMPLETENESS CHECK: ISF.LINKLIB (LINK
//* LIST, APF), ISF.ISFCLST (TSO SYSPROC), SYSGEN.NJE38.AUTHLIB,
//* SYS1.VTAMLIB, SYS1.INDMAC (APF), SYS1.HELP, SYS2.HELP (SYSHELP) AND
//* THE SUBMITTER'S OWN CLIST/EXEC (&SYSUID IN TSOLOGON). BATCH TSO DOES
//* NOT PREFIX UNQUOTED NAMES: THE RUNNER QUALIFIES THEM WITH USER=.
//LIST     EXEC PGM=IKJEFT01,DYNAMNBR=20,COND=EVEN
//SYSTSPRT DD  SYSOUT=*
//SYSTSIN  DD  *
 LISTDS 'SYS1.LINKLIB' MEMBERS
 LISTDS 'BREXX.LINKLIB' MEMBERS
 LISTDS 'SYS2.LINKLIB' MEMBERS
 LISTDS 'SYS1.CMDLIB' MEMBERS
 LISTDS 'SYS2.CMDLIB' MEMBERS
 LISTDS 'SYSC.LINKLIB' MEMBERS
 LISTDS 'SYS1.LPALIB' MEMBERS
 LISTDS 'SYS1.SVCLIB' MEMBERS
 LISTDS 'HTTPD.LINKLIB' MEMBERS
 LISTDS 'MVSMF.LINKLIB' MEMBERS
 LISTDS 'SYS1.PROCLIB' MEMBERS
 LISTDS 'SYSC.PROCLIB' MEMBERS
 LISTDS 'SYS2.PROCLIB' MEMBERS
 LISTDS 'BREXX.PROCLIB' MEMBERS
 LISTDS 'SYS1.CMDPROC' MEMBERS
 LISTDS 'SYS2.CMDPROC' MEMBERS
 LISTDS 'SYS2.EXEC' MEMBERS
 LISTDS 'SYS2.STCEXEC' MEMBERS
 LISTDS 'BREXX.CURRENT.RXLIB' MEMBERS
 LISTDS 'SYS1.PARMLIB' MEMBERS
 LISTDS 'SYS2.PARMLIB' MEMBERS
 LISTDS 'IBMUSER.CLIST' MEMBERS
 LISTDS 'IBMUSER.EXEC' MEMBERS
 LISTDS 'ISF.LINKLIB' MEMBERS
 LISTDS 'ISF.ISFCLST' MEMBERS
 LISTDS 'SYSGEN.NJE38.AUTHLIB' MEMBERS
 LISTDS 'SYS1.VTAMLIB' MEMBERS
 LISTDS 'SYS1.INDMAC' MEMBERS
 LISTDS 'SYS1.HELP' MEMBERS
 LISTDS 'SYS2.HELP' MEMBERS
 LISTDS CLIST MEMBERS
 LISTDS EXEC MEMBERS
 LISTCAT LEVEL(OSE) ALL
 LISTCAT ENTRIES('OSE') ALL
/*
//
