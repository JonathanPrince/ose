//OSELIST  JOB (OSE),'OSE-011 NAMES',CLASS=A,MSGCLASS=A,
//             MSGLEVEL=(1,1)
//*--------------------------------------------------------------------
//* OSE-011 NAME-COLLISION LISTING (READ-ONLY).  NOT RUN YET: IT NEEDS
//* THE OSE-003 GUEST AND A LEASE.  THE SUBMITTER SUPPLIES USER= AND
//* PASSWORD= AT SUBMIT TIME; THEY ARE NEVER STORED IN THE REPOSITORY.
//*
//* STEP LIST : TSO IN BATCH LISTS THE MEMBERS OF EVERY LIBRARY WHERE A
//*             TSO COMMAND, PROGRAM OR STARTED PROCEDURE NAME COULD
//*             COLLIDE, AND THE CATALOG ENTRIES FOR THE CANDIDATE HLQ.
//*             A LIBRARY THAT DOES NOT EXIST ON THIS IMAGE GIVES A
//*             LISTDS ERROR, WHICH IS ITSELF EVIDENCE.
//*             EXPECTED RC 0-12.
//* STEP SSN  : PRINTS THE SUBSYSTEM NAME TABLE IEFSSN00.
//*             EXPECTED RC 0.
//*
//* CANDIDATE NAMES (RESEARCH 2026-11-26-TSO-TERMINAL-AUDIT N-1):
//*   COMMAND OMVS, OSH     HLQ OSE     STC OSE, OSED
//*   SUBSYSTEM OSE1, OSES  (MUST DIFFER FROM THE STC NAME)
//* SEARCH THE OUTPUT FOR EACH NAME AS A WHOLE MEMBER NAME OR ALIAS.
//*--------------------------------------------------------------------
//LIST     EXEC PGM=IKJEFT01,DYNAMNBR=20
//SYSTSPRT DD  SYSOUT=*
//SYSTSIN  DD  *
 LISTDS 'SYS1.CMDLIB' MEMBERS
 LISTDS 'SYS2.CMDLIB' MEMBERS
 LISTDS 'SYS1.LINKLIB' MEMBERS
 LISTDS 'SYS2.LINKLIB' MEMBERS
 LISTDS 'SYS1.LPALIB' MEMBERS
 LISTDS 'SYS1.PROCLIB' MEMBERS
 LISTDS 'SYS2.PROCLIB' MEMBERS
 LISTDS 'SYS1.PARMLIB' MEMBERS
 LISTCAT LEVEL(OSE) ALL
 LISTCAT ENTRIES('OSE') ALL
/*
//SSN      EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  DUMMY
//SYSUT1   DD  DSN=SYS1.PARMLIB(IEFSSN00),DISP=SHR
//SYSUT2   DD  SYSOUT=*
//
